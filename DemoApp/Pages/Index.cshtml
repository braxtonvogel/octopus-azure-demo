@page
@model IndexModel
@{ ViewData["Title"] = "Notes"; }

<h1>Notes</h1>
<form method="post" class="mb-3">
    <input asp-for="NewText" id="note-text" class="form-control mb-2" placeholder="Write a note..." maxlength="500" />
    @if (Model.ShowCharacterCounter)
    {
        <small id="note-counter" class="text-muted d-block mb-2">0 / 500</small>
        <script>
            (function () {
                var box = document.getElementById('note-text'), out = document.getElementById('note-counter');
                var update = function () { out.textContent = box.value.length + ' / 500'; };
                box.addEventListener('input', update);
                update();
            })();
        </script>
    }
    <span asp-validation-for="NewText" class="text-danger"></span>
    <button type="submit" class="btn btn-primary">Add note</button>
</form>
<ul>
@foreach (var n in Model.Notes)
{
    <li>@n.Text <small class="text-muted">(@n.CreatedUtc.ToString("g") UTC)</small></li>
}
</ul>